rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só acessa o próprio documento.
    // Exclusão definitiva é bloqueada: a conta é só marcada como deleted (soft delete).
    match /users/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
